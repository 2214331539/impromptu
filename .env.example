POSTGRES_DB=speaking_lab
POSTGRES_USER=speaking
POSTGRES_PASSWORD=speaking_local
DATABASE_URL=postgresql+psycopg://speaking:speaking_local@127.0.0.1:5432/speaking_lab
JWT_SECRET=replace-this-with-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_MAX_MB=20
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=http://127.0.0.1:8001/api/v1
BACKEND_PORT=8001
FRONTEND_PORT=5173
SEED_DEMO_DATA=true
# Optional: use a nearby Debian mirror when the official package source is slow.
DEBIAN_MIRROR_HOST=deb.debian.org
# Optional: use a nearby Python package index when PyPI is slow.
PIP_INDEX_URL=https://pypi.org/simple
STORAGE_BACKEND=oss
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET_NAME=your-bucket-name
OSS_BUCKET_DOMAIN=https://your-bucket-name.oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_RECORDING_PREFIX=recordings
OSS_TEST_PREFIX=connectivity-tests
